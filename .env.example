# Copia a `.env` y rellena los valores. No commitees `.env`.

# --- Base de datos PostgreSQL (requerido; ver payload.config.ts) ---
DATABASE_URI=postgresql://usuario:contraseña@127.0.0.1:5432/nombre_db
#
# Publicar cambios de esquema (Neon producción): pon aquí la URI de Neon, luego:
#   pnpm run migrate    # solo migraciones
#   pnpm run release    # migrate + git push (ver scripts/release.mjs)
#
# Vacía TODA la base apuntada por DATABASE_URI y vuelve a aplicar migraciones (PELIGRO):
#   PowerShell:  $env:RADAR_RESET_DB_CONFIRM="yes"; pnpm run db:reset-and-migrate
# Luego crea un usuario en /admin y vuelve a publicar contenido si aplica.
#
# Si el deploy en Vercel se cuelga con el mensaje "run Payload in dev mode", en Neon
# ejecuta el SQL en scripts/clear-payload-dev-migration-marker.sql (una vez, con cuidado).

# --- Payload / Next ---
PAYLOAD_SECRET=genera_una_cadena_larga_aleatoria
# Sin barra final. El código también la recorta, pero en Vercel debe ser el origen canónico:
# https://www.radarmex.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

CRON_SECRET=secreto_para_jobs_cron
PREVIEW_SECRET=secreto_para_preview

# --- Opcional: volcar Neon a local (pnpm run db:sync-neon) ---
# NEON_DATABASE_URI=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Medios nuevos: Cloudflare R2 (API S3). Ver README, sección "Medios: Cloudflare R2". ---
# Si R2_BUCKET tiene valor, Payload sube la colección media solo a R2 y GCS no se usa.
# Si R2_BUCKET está vacío, sigue el comportamiento GCS de abajo.
# No pongas ACL: R2 no las admite. El público entra por R2_PUBLIC_URL.
# R2_ENDPOINT opcional. Si falta, se arma https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL sin barra final, p. ej. https://pub-xxxx.r2.dev o https://media.tudominio.com
# Cambiar R2_PUBLIC_URL exige un redeploy: Next fija el host de imágenes en el build.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# --- Google Cloud Storage (solo si R2_BUCKET está vacío) ---
# GCS_PRIVATE_KEY: PEM del service account; en una línea puedes usar \n escapados.
# Las URLs públicas históricas son https://storage.googleapis.com/<GCS_BUCKET>/<filename>.
# Los objetos ya guardados no se copian ni se reescriben al activar R2.
GCS_BUCKET=
GCS_ENDPOINT=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
